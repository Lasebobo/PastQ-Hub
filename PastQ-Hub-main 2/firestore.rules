rules_version = '2';

// PastQ-Hub Firestore security rules.
//
// Principle: the browser decides nothing about authorisation. A user's role lives
// in their `users/{uid}` document, which they may create but may NOT change — only
// an existing admin can grant a role. This is what closes the current hole where
// anyone can register as an admin.
//
// NOT YET DEPLOYED. Deploy with:  firebase deploy --only firestore:rules
//
// ⚠️ Deploying these rules changes two app behaviours. Read before you deploy:
//
//   1. Self-registration always produces a STUDENT. The role picker on the sign-up
//      form (and the OAU_ADMIN_2024 code) stops working — by design, since it was
//      the hole. Promote the first admin by hand in the Firebase console, then use
//      that account to promote everyone else.
//   2. Lecturers can submit questions but only with status "pending". Only admins
//      can approve. That already matches the intended workflow; it just wasn't
//      enforced before.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile() && profile().role == 'admin';
    }

    function isStaff() {
      return hasProfile() && (profile().role == 'admin' || profile().role == 'lecturer');
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Own profile, or any profile if you're an admin (the Admin Panel counts users).
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // You may create only your own profile, and only as a student.
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'student'
                    && request.resource.data.id == userId;

      // You may edit your own profile but NOT your role — that is the escalation path.
      // Bookmarks live on this document, so students must be able to write it.
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      // Only an admin can change someone's role, and only an admin can delete.
      allow update, delete: if isAdmin();
    }

    // ── questions ────────────────────────────────────────────────────────────
    match /questions/{questionId} {
      // Students see approved questions. Staff see everything, including pending
      // submissions awaiting review.
      allow read: if signedIn() && (resource.data.status == 'approved' || isStaff());

      // Lecturers and admins may submit, but a submission always starts as pending
      // and is always attributed to its actual author. An admin may seed approved
      // content directly (the "Seed demo data" button).
      allow create: if isStaff()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow create: if isAdmin();

      // Approving, rejecting, editing and deleting are admin-only.
      allow update, delete: if isAdmin();
    }

    // ── threads (forum) ──────────────────────────────────────────────────────
    match /threads/{threadId} {
      function changesOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.authorId == request.auth.uid;

      // Thread updates are intentionally narrow: replies live in a subcollection, so
      // regular users only need likes, reports, view increments and reply counts.
      allow update: if isAdmin();
      allow update: if signedIn()
                    && (
                      (changesOnly(['likes']) && request.resource.data.likes is list)
                      || (changesOnly(['flagged', 'flagReason', 'flaggedBy', 'flaggedAt'])
                          && request.resource.data.flagged == true)
                      || (changesOnly(['views'])
                          && request.resource.data.views == resource.data.get('views', 0) + 1)
                      || (changesOnly(['replyCount'])
                          && request.resource.data.replyCount == resource.data.get('replyCount', 0) + 1)
                    );

      // Authors can delete their own threads; admins can delete any.
      allow delete: if isAdmin()
                    || (signedIn() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
                      && exists(/databases/$(database)/documents/threads/$(threadId))
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.role in ['Admin', 'Lecturer', 'Student']
                      && request.resource.data.likes is list
                      && request.resource.data.likes.size() == 0;

        // Comment text and ownership are immutable from the browser; users may only
        // update the likes array.
        allow update: if signedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                      && request.resource.data.authorId == resource.data.authorId
                      && request.resource.data.authorName == resource.data.authorName
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.content == resource.data.content
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.likes is list;

        allow delete: if isAdmin()
                      || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // Anything not matched above is denied.
  }
}
