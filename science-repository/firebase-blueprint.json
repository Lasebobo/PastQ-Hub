{
  "collections": [
    {
      "name": "users",
      "documentId": "userId",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "email", "type": "string" },
        { "name": "name", "type": "string" },
        { "name": "role", "type": "string" },
        { "name": "bookmarkedQuestions", "type": "array" }
      ],
      "rules": {
        "read": "isAuthenticated() && request.auth.uid == userId",
        "write": "isAuthenticated() && request.auth.uid == userId"
      }
    },
    {
      "name": "courses",
      "documentId": "courseId",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "code", "type": "string" },
        { "name": "title", "type": "string" },
        { "name": "department", "type": "string" },
        { "name": "level", "type": "string" },
        { "name": "semester", "type": "string" }
      ],
      "rules": {
        "read": "isAuthenticated()",
        "write": "isAdmin()"
      }
    },
    {
      "name": "questions",
      "documentId": "questionId",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "courseId", "type": "string" },
        { "name": "courseCode", "type": "string" },
        { "name": "year", "type": "number" },
        { "name": "topic", "type": "string" },
        { "name": "questionText", "type": "string" },
        { "name": "solutionText", "type": "string" },
        { "name": "explanation", "type": "string" },
        { "name": "difficulty", "type": "string" },
        { "name": "questionType", "type": "string" },
        { "name": "status", "type": "string" },
        { "name": "tags", "type": "array" },
        { "name": "createdAt", "type": "number" },
        { "name": "createdBy", "type": "string" }
      ],
      "rules": {
        "read": "isAuthenticated() && (resource.data.status == 'approved' || isAdmin())",
        "write": "isAdmin()"
      }
    }
  ]
}
